{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-connection/client": [
        "/root/.dsh/source/current/packages/client/connection/lib/types/client"
      ],
      "@deepseek-ai/dsh-client-locale/src/*": [
        "/root/.dsh/source/current/packages/client/locale/src/*"
      ],
      "@deepseek-ai/dsh-client-runtime/client": [
        "/root/.dsh/source/current/packages/client/runtime/lib/types/client"
      ],
      "@deepseek-ai/dsh-client-test-runtime": [
        "/root/.dsh/source/current/packages/client/test-runtime/lib/types"
      ],
      "@deepseek-ai/dsh-client-ui-conversation/client": [
        "/root/.dsh/source/current/packages/client/ui-conversation/lib/types/client"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "/root/.dsh/source/current/packages/client/ui-primitives/lib/types"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "/root/.dsh/source/current/packages/client/ui-slots/lib/types"
      ],
      "@deepseek-ai/dsh-client-web-react": [
        "/root/.dsh/source/current/packages/client/web-react/lib/types"
      ],
      "@deepseek-ai/dsh-invariants": [
        "/root/.dsh/source/current/packages/support/invariants/lib/types"
      ],
      "@deepseek-ai/dsh-llm/types": [
        "/root/.dsh/source/current/packages/llm/llm/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "/root/.dsh/source/current/packages/client/locale/lib/types/client"
      ],
      "cordis": [
        "/root/.dsh/source/current/vendor/cordis/lib/types"
      ],
      "react": [
        "/root/.dsh/source/current/apps/web/node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "/root/.dsh/source/current/apps/web/node_modules/@types/react/jsx-runtime.d.ts"
      ]
    },
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": true,
    "typeRoots": [
      "/root/.dsh/source/current/node_modules/@types",
      "/root/.dsh/source/current/apps/web/node_modules/@types"
    ]
  },
  "include": [
    "src",
    "tests"
  ]
}
