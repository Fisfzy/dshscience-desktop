    "@deepseek-ai/dsh-toolkit": "file:vendor/@deepseek-ai/dsh-toolkit",
    "@dsh-external/dsh-input-history": "file:vendor/@dsh-external/dsh-input-history",
    "@dsh-external/dsh-session-search": "file:vendor/@dsh-external/dsh-session-search",
    "@dsh-external/dsh-ui-progress": "file:vendor/@dsh-external/dsh-ui-progress",
    "@dsh-external/zotero-harvest": "file:vendor/@dsh-external/zotero-harvest",
    "@fisfzy/zotero-wave-rag": "file:vendor/@fisfzy/zotero-wave-rag",
    "dsh-cae-agent": "file:vendor/dsh-cae-agent",
    "dsh-danus": "file:vendor/dsh-danus",
    "dsh-ego-browser": "file:vendor/dsh-ego-browser",
