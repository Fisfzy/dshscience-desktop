  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/**",
    "skills/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
